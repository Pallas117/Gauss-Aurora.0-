# Tailscale/mobile dev notes:
# 1) Use `npm run dev:tailscale` to bind frontend/backend to your Tailscale IP.
# 2) For tailnet hardening prefer explicit TS IPs over 0.0.0.0 (hotspot/LAN mode may intentionally use 0.0.0.0).
# 3) Run `npm run dev:tailscale:doctor` before launch; use `:doctor:fix` to clear stale ports.
# 4) If CLI is unhealthy, pass TS_IP manually: `TS_IP=100.x.y.z npm run dev:tailscale`.
# 5) `dev:tailscale` auto-corrects loopback hosts to your tailnet IP for mobile reachability.

# Turing pool (Tailscale devices: cache + compute)
TURING_POOL_ENABLED=true
TURING_REGISTER_SECRET=
TURING_REGISTRATION_MODE=join-code
TURING_DEVICE_IP_POLICY=tailnet
TURING_ALLOW_SHARED_HEARTBEAT_SECRET=false
TURING_ALLOW_BODY_SECRET=false
TURING_AUTOSCALER_ENABLED=false
TURING_AUTOSCALER_MODE=observe
TURING_AUTOSCALER_INTERVAL_MS=30000
TURING_AUTOSCALER_MIN_HEALTHY=1
TURING_AUTOSCALER_MAX_NODES=32
TURING_AUTOSCALER_SCALE_OUT_QUEUE=2
TURING_AUTOSCALER_SCALE_IN_QUEUE=0
TURING_AUTOSCALER_TARGET_JOBS_PER_NODE=2
TURING_AUTOSCALER_COOLDOWN_MS=60000
TURING_AUTOSCALER_HEAL_COOLDOWN_MS=300000
# Scale-out requires two RSS samples whose growth is <= this tolerance.
# Keep zero for strict net-zero/net-negative admission; use a small value only
# after measuring allocator noise on the target host.
TURING_AUTOSCALER_MEMORY_GROWTH_TOLERANCE_MB=0
TURING_AUTOSCALER_SPACECRAFT_APPROVAL_REQUIRED=true
TURING_AUTOSCALER_DESIRED_CAPACITY=
TURING_AUTOSCALER_QUEUE_DEPTH=0
TURING_AUTOSCALER_NETWORK_HEALTH=nominal
TURING_AUTOSCALER_PROVISION_URL=
TURING_AUTOSCALER_PROVISION_TOKEN=
TURING_HEARTBEAT_STALE_MIN=5
TURING_DEVICE_PORT=8090
TURING_MIN_BATTERY_PERCENT=25
TURING_NETWORK_INVENTORY_ENABLED=false
TURING_NETWORK_INVENTORY_INTERVAL_SEC=300
TURING_NETWORK_INVENTORY_STALE_MIN=15
TURING_NETWORK_DISCOVERY_MODE=passive
TURING_NETWORK_DISCOVERY_APPROVED=false
TURING_NETWORK_DISCOVERY_CIDRS=
TURING_NETWORK_DISCOVERY_PORTS=
TURING_NETWORK_DISCOVERY_MAX_TARGETS=64
TURING_NETWORK_DISCOVERY_MAX_PROBES=128
TURING_RADIATION_SCHEDULER_ENABLED=true
TURING_RADIATION_SCHEDULER_INTERVAL_MS=30000
TURING_RADIATION_MAX_JOBS_PER_TICK=2
TURING_RADIATION_MAX_JOBS_PER_DEVICE=1
TURING_RADIATION_REQUIRED_MEMORY_MB=256
TURING_RADIATION_MIN_BATTERY_PERCENT=40
TURING_RADIATION_MAX_ATTEMPTS=3
TURING_RADIATION_LEASE_MS=120000
TURING_RADIATION_HEAL_COOLDOWN_MS=300000
# Completed/failed records are retained for diagnostics, while payload samples
# are released immediately after a result is accepted.
TURING_RADIATION_COMPLETED_RETENTION=16

# Shared-compute evidence audit. The operator token is read only from the
# process environment and is never printed; leave the worker URL empty to
# derive it from the observed local Tailscale address.
# TURING_AUDIT_BACKEND_URL=http://127.0.0.1:3001
# TURING_AUDIT_WORKER_URL=http://100.x.y.z:8090
# TURING_AUDIT_OPERATOR_TOKEN=
# TURING_AUDIT_MIN_FREE_MEMORY_MB=256

# Network data refinery/inference gateway. Keep hybrid until the gateway is redundant.
GAUSS_PROCESSING_MODE=hybrid
GAUSS_NETWORK_PROCESSING_URL=
GAUSS_PROCESSING_ALLOW_LOCAL_FALLBACK=true
GAUSS_PROCESSING_TIMEOUT_MS=8000

# Optional cloud-independent provenance mesh. Enable only after three validator
# identities are provisioned; the ledger stores hashes/metadata, never payloads.
GAUSS_MESH_ENABLED=false
GAUSS_MESH_NODE_ID=
GAUSS_MESH_VALIDATORS=
GAUSS_MESH_TRANSPORT=tailscale
GAUSS_MESH_MAX_EVENTS_PER_BLOCK=256
GAUSS_MESH_CLOUD_ANCHOR_ENABLED=false

# Hardened Kali backend profile. Leave local for development. In network_only
# mode the backend fails closed before listening unless these services are
# HTTPS/PQC-capable network gateways; the deploy script never copies local .env.
GAUSS_SENSITIVE_DATA_MODE=local
GAUSS_DEPLOYMENT_ROLE=local
GAUSS_SENSITIVE_STORE_URL=
GAUSS_SENSITIVE_STORE_PQC_REQUIRED=false
GAUSS_SENSITIVE_STORE_PQC_PROFILE=
GAUSS_LOCAL_SENSITIVE_WRITES=true

# Optional staff OIDC/JWKS federation. Require the upstream PQC gateway profile in production.
STAFF_AUTH_ISSUER=
STAFF_AUTH_AUDIENCE=
STAFF_AUTH_JWKS_URL=
STAFF_AUTH_ALLOWED_ALGORITHMS=EdDSA,ES256,RS256
STAFF_AUTH_CRYPTO_PROFILE=hybrid-pqc-v1
STAFF_AUTH_PQC_GATEWAY_REQUIRED=false
