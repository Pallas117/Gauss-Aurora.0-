# Frontend
# Auth: use real Supabase project URL and anon key from Project Settings > API. Do not leave placeholders.
# See docs/AUTH_TROUBLESHOOTING.md if login fails.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Optional: Stripe Payment Link or Checkout URL for Operator plan (sign-up step "Check out with Stripe").
VITE_STRIPE_CHECKOUT_URL=
# Backend Stripe (partner onboarding): create-checkout-session. Set STRIPE_SECRET_KEY and Price IDs from Stripe Dashboard.
# STRIPE_SECRET_KEY=sk_...
# STRIPE_PRICE_STUDENT=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# STRIPE_PRICE_ACADEMIC=price_...
# STRIPE_PRICE_OPERATOR=price_...
# STRIPE_SUCCESS_URL=http://localhost:8080/onboarding?success=1
# STRIPE_CANCEL_URL=http://localhost:8080/onboarding
VITE_GAUSS_RAG_URL=http://localhost:3002
# Directory to index for RAG (sent to POST /api/rag/index). Use path relative to repo root or absolute.
VITE_GAUSS_RAG_INDEX_DIR=research/documentation-rag
VITE_HELIO_PROXY_URL=http://localhost:3001
# Frontend bind host for `npm run dev`. Use 0.0.0.0 for hotspot/LAN access.
FRONTEND_HOST=0.0.0.0
VITE_HELIO_WS_ENABLED=false
VITE_POWER_PROFILE=auto
VITE_POLL_INTERVAL_MULTIPLIER=1
# Frontend charging-flow mode: recharge-first | balanced | performance
VITE_BATTERY_DRAIN_MODE=balanced
VITE_CANVAS_PRESERVE_BUFFER=false
VITE_ENABLE_GAUSS_UI_SHELL=true
# SDA front-and-center: set to "sda" to open app on SDA visualization (demos, projectors, hackathons). See docs/UI_UX_SCALING_AND_PRESENTATION.md.
# VITE_DEFAULT_LANDING=sda
VITE_ENABLE_GLOBE_OVERLAY=false
VITE_ENABLE_OFFLINE_SW=true
# Space debris / risk zones in 3D: default ON for critical ops. Set to "false" to disable. See docs/DEBRIS_RISK_3D.md.
# VITE_FEATURE_DEBRIS_3D=true

# Backend proxy
# Auth: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY required for /api/auth/session. Restart backend after changing.
# Optional: AUTH_REQUIRE_EMAIL_VERIFIED=false to skip email verification (dev only).
# Staff-by-email: grant heliophysics + debris to users whose email domain or address is listed (one flow for all).
# STAFF_EMAIL_DOMAINS=@company.com,lightbound.io
# STAFF_EMAILS=ops@example.com,admin@example.com
PROXY_PORT=3001
# Backend bind host. Use 0.0.0.0 for hotspot/LAN access, or a specific private/Tailscale IP for tighter exposure.
PROXY_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8080
# Allow hotspot/LAN/Tailscale browser origins on known dev ports (8080/3008/4173).
# Set false in hardened environments where only explicit ALLOWED_ORIGINS should pass.
ALLOW_PRIVATE_NETWORK_ORIGINS=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
AUTH_REQUIRED=true
AUTH_REQUIRE_EMAIL_VERIFIED=true
CYBERTIGER_ENABLED=true
CYBERTIGER_RATE_LIMIT_WINDOW_MS=60000
CYBERTIGER_RATE_LIMIT_MAX=120
CYBERTIGER_AUTH_FAILURE_WINDOW_MS=300000
CYBERTIGER_AUTH_FAILURE_THRESHOLD=8
CYBERTIGER_AUTO_BLOCK_SECONDS=900
CYBERTIGER_MAX_EVENTS=5000
LOCAL_INFER_URL=http://localhost:8000
TRAINING_SCRIPT_PATH=ml/train/train_unet.py
GAUSS_PREINFERENCE_GATE_ENABLED=true
GAUSS_PREINFERENCE_GATE_LOG=false
GAUSS_GATE_FLUX_THRESHOLD=1.5e-4
GAUSS_GATE_SAFETY_MARGIN=0.15
GAUSS_GATE_SIGMA=5e-5
GAUSS_GATE_THREAT_TRIGGER_SCORE=0.72
INGEST_POWER_PROFILE=nominal
POWER_SAVE_MODE=false
# Charging-flow adaptive ingest cadence
# INGEST_ADAPTIVE_CHARGING_FLOW=true
# INGEST_POWER_FLOW_SAMPLE_MS=60000
# INGEST_CHARGING_FLOW_MODE=balanced  # recharge-first | balanced | performance
# Discharging safety floor for orchestrator sweep/audit/backprop
# ORCHESTRATOR_DISCHARGING_MIN_SAFE_BATTERY_PERCENT=45
# Air-gapped: when true, backend ingestion will not call external internet sources (NOAA/ESA/JAXA/MMS/SSA).
# Only localhost / Tailscale flows should be used. Backend will emit stale/low-confidence outputs using last-known state + safe defaults.
GAUSS_AIR_GAP=false
# Debris/risk zones 3D: see docs/DEBRIS_RISK_3D.md. Either Privateer or open TLE catalog.
# Optional: Privateer API (Wayfinder/Crow's Nest) for risk zones.
# PRIVATEER_API_URL=
# PRIVATEER_API_KEY=  (or PRIVATEER_API_TOKEN)
# Optional: TLE catalog URL for debris risk zones (default: CelesTrak GEO when Privateer not set).
# TLE_CATALOG_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle
# Optional: TLE URL for satellite/object list (high-value & unidentified). Defaults to TLE_CATALOG_URL.
# Use last-30-days for more unidentified: .../gp.php?GROUP=last-30-days&FORMAT=tle
# TLE_SATELLITES_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle
# Comma-separated NORAD IDs to tag as high-value (default: 25544 = ISS).
# TLE_HIGH_VALUE_NORAD_IDS=25544
# Set true for production packet telemetry (CCSDS/XTCE); see docs/CCSDS_XTCE_ORCHESTRATOR.md
ORCHESTRATOR_DECODE_ENABLED=false
ORCHESTRATOR_XTCE_PATH=./gauss-orchestrator/config/xtce/baseline.xtce.xml
ORCHESTRATOR_APID_MAP_PATH=./gauss-orchestrator/config/xtce/apid-map.json
ORCHESTRATOR_INGEST_API_URL=http://127.0.0.1:3001/api/ingest/telemetry/packets
ORCHESTRATOR_INGEST_API_TOKEN=
ORCHESTRATOR_PACKET_MAX_BATCH=250
ORCHESTRATOR_PACKET_MAX_BYTES=1048576
ORCHESTRATOR_PACKET_CRC_ENABLED=false
# Optional: bind for decode API (e.g. 127.0.0.1:8092). POST /telemetry/decode returns decode+map JSON without ingest.
# ORCHESTRATOR_DECODE_API_BIND=127.0.0.1:8092
# When set, backend POST /api/ops/pipeline/triad uses orchestrator Rust triad (POST {base}/pipeline/triad). Same host/path as decode API.
# ORCHESTRATOR_TRIAD_URL=http://127.0.0.1:8092
# Optional: enable pass API command execution for /api/ops/command execute flow and /api/ops/command/deepseek planner.
# ORCHESTRATOR_PASS_API_ENABLED=false
# ORCHESTRATOR_PASS_API_BIND=127.0.0.1:8091
# Optional override for backend DTN/ISL polling endpoint (defaults to http://{ORCHESTRATOR_PASS_API_BIND}/network/audit).
# ORCHESTRATOR_PASS_API_NETWORK_AUDIT_URL=http://127.0.0.1:8091/network/audit
# ORCHESTRATOR_PASS_API_BASE_URL=http://127.0.0.1:8091
# ORCHESTRATOR_PASS_API_PLAN_URL=http://127.0.0.1:8091/passes/plan
# ORCHESTRATOR_PASS_API_RETRIES=2
# ORCHESTRATOR_PASS_API_RETRY_DELAY_MS=250
# ORCHESTRATOR_PASS_API_CIRCUIT_FAILURE_THRESHOLD=3
# ORCHESTRATOR_PASS_API_CIRCUIT_COOLDOWN_MS=30000
# Planner resilience and adaptive model profile
# ORCHESTRATOR_PLANNER_RETRIES=2
# ORCHESTRATOR_PLANNER_RETRY_DELAY_MS=250
# ORCHESTRATOR_PLANNER_TIMEOUT_MS=30000
# ORCHESTRATOR_PLANNER_CIRCUIT_FAILURE_THRESHOLD=3
# ORCHESTRATOR_PLANNER_CIRCUIT_COOLDOWN_MS=30000
# ORCHESTRATOR_CHAT_MODEL_LOW_POWER=DeepSeek-R1-Distill-Qwen-1.5B-4bit
# ORCHESTRATOR_CHAT_MODEL_BALANCED=DeepSeek-R1-Distill-Qwen-1.5B-4bit
# ORCHESTRATOR_CHAT_MODEL_PERFORMANCE=DeepSeek-R1-Distill-Qwen-7B
# ORCHESTRATOR_CHAT_MAX_TOKENS_LOW_POWER=180
# ORCHESTRATOR_CHAT_MAX_TOKENS_BALANCED=300
# ORCHESTRATOR_CHAT_MAX_TOKENS_PERFORMANCE=420
# Durable ops command queue/idempotency across processes
# ORCHESTRATOR_OPS_PERSIST_ENABLED=true
# ORCHESTRATOR_OPS_IDEMPOTENCY_TTL_MS=600000
# ORCHESTRATOR_OPS_RECLAIM_RUNNING_AFTER_MS=120000
# DeepSeek safe command runner (strict allowlist + approval + timeout)
# ORCHESTRATOR_SAFE_COMMAND_RUNNER_ENABLED=false
# ORCHESTRATOR_SAFE_COMMAND_ALLOWLIST=pmset,uptime,df,vm_stat,sysctl,system_profiler,networksetup,ioreg,lsof,ps
# ORCHESTRATOR_SAFE_COMMAND_REQUIRE_APPROVAL=true
# ORCHESTRATOR_SAFE_COMMAND_APPROVAL_TTL_MS=300000
# ORCHESTRATOR_SAFE_COMMAND_TIMEOUT_MS=12000
# ORCHESTRATOR_SAFE_COMMAND_MAX_OUTPUT_BYTES=32768
# ORCHESTRATOR_SAFE_COMMAND_MAX_PENDING_APPROVALS=512
# ORCHESTRATOR_SAFE_COMMAND_CWD=
# ORCHESTRATOR_SAFE_COMMAND_PLANNER_FALLBACK_ENABLED=true
# Demo-only: when true, safe-command planner/execute continues with in-memory audit records if PostgreSQL audit logging is unavailable.
# ORCHESTRATOR_SAFE_COMMAND_AUDIT_SOFT_FAIL=false

# Optional RBAC smoke test settings
BACKEND_BASE_URL=http://127.0.0.1:3001
RBAC_VIEWER_EMAIL=
RBAC_VIEWER_PASSWORD=
RBAC_OPERATOR_EMAIL=
RBAC_OPERATOR_PASSWORD=
RBAC_ADMIN_EMAIL=
RBAC_ADMIN_PASSWORD=
RBAC_TEST_TRAIN=false
RBAC_FORCE_PASSWORD_UPDATE=true
RBAC_EMAIL_CONFIRMED=true

# Full-stack mission validation harness
FRONTEND_BASE_URL=http://127.0.0.1:8080
# Local chat engine: npm start (dev:stack:mlx) starts MLX DeepSeek on 8088 automatically.
# Stub only: npm run dev:stack (no Python/mlx required). Leave URLs empty to skip the startup check.
GAUSS_BRAIN_URL=http://127.0.0.1:8088/v1
ORCHESTRATOR_LOCAL_ENGINE_URL=http://127.0.0.1:8088/v1/chat/completions
# Surya heliophysics service: backend proxies /api/ai/surya/forecast and .../flare to this URL when set.
# Run ml/surya_service.py (e.g. SURYA_SERVICE_PORT=3003) and set SURYA_SERVICE_URL=http://127.0.0.1:3003
# SURYA_SERVICE_URL=
# SURYA_SERVICE_PORT=3003
# SURYA_SERVICE_HOST=127.0.0.1
ORCHESTRATOR_CHAT_MODEL=DeepSeek-R1-Distill-Qwen-1.5B-4bit
GAUSS_BRAIN_HOST=127.0.0.1
GAUSS_BRAIN_PORT=8089
GAUSS_RAG_URL=http://127.0.0.1:3002
# RAG service (npm run dev:rag): port, host, and LanceDB path
GAUSS_RAG_PORT=3002
GAUSS_RAG_HOST=127.0.0.1
GAUSS_RAG_DB_PATH=
FULLSTACK_RUN_ID=
FULLSTACK_WRITE_MODE=controlled
FULLSTACK_CLEANUP=true
FULLSTACK_SKIP_UI_E2E=false
FULLSTACK_SKIP_UI_MOBILE=false
# Optional: set current battery % for audit, backprop, and test:sweep (enforces min_safe_battery_percent from work-queue; on macOS pmset -g batt is used if unset).
# BATTERY_PERCENT=100

# Bxr stack (Kafka, Redis, InfluxDB, PostgreSQL) – docker compose up -d
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=gauss-influx-admin-token
INFLUXDB_ORG=gauss
INFLUXDB_BUCKET=telemetry
# Direct Postgres URI (backend command_log). Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
POSTGRES_URL=postgresql://postgres:[YOUR-PASSWORD]@db.qmlanlazhbhiwcaxgzxt.supabase.co:5432/postgres

# Telegram helper (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GAUSS_TELEGRAM_SENDER=Gauss Ops

# Secure connectivity agent (hotspot primary, Wi-Fi secondary)
GAUSS_PRIMARY_HOTSPOT_SSID=
GAUSS_PRIMARY_HOTSPOT_PASSWORD=
GAUSS_SECONDARY_WIFI_SSID=
GAUSS_SECONDARY_WIFI_PASSWORD=
GAUSS_PRIMARY_NETWORK_SERVICE=iPhone USB
GAUSS_SECONDARY_NETWORK_SERVICE=Wi-Fi
GAUSS_NETWORK_INTERVAL_SECS=90
GAUSS_NETWORK_APPROVAL_TIMEOUT_SECS=180
GAUSS_NETWORK_AUTO_APPROVE=false
GAUSS_NETWORK_BYPASS_APPROVAL=false
GAUSS_CONNECTIVITY_PROBE_URL=https://www.gstatic.com/generate_204

# Tailscale/mobile dev notes:
# 1) Use `npm run dev:tailscale` to bind frontend/backend to your Tailscale IP.
# 2) For tailnet hardening prefer explicit TS IPs over 0.0.0.0 (hotspot/LAN mode may intentionally use 0.0.0.0).
# 3) Run `npm run dev:tailscale:doctor` before launch; use `:doctor:fix` to clear stale ports.
# 4) If CLI is unhealthy, pass TS_IP manually: `TS_IP=100.x.y.z npm run dev:tailscale`.
# 5) `dev:tailscale` auto-corrects loopback hosts to your tailnet IP for mobile reachability.

# Turing pool (Tailscale devices: cache + compute)
TURING_POOL_ENABLED=true
TURING_REGISTER_SECRET=
TURING_HEARTBEAT_STALE_MIN=5
TURING_DEVICE_PORT=8090
TURING_MIN_BATTERY_PERCENT=25
