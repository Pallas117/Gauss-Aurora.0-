KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=gauss-influx-admin-token
INFLUXDB_ORG=gauss
INFLUXDB_BUCKET=telemetry
