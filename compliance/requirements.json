  "requirements": [
    {
      "id": "GOV-001",
      "title": "Governance scope, ownership, and evidence are documented",
      "sources": ["iso-27001-2022", "nist-csf-2", "nist-ir-8270"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_exists", "path": "docs/CYBERTIGER_COMPLIANCE_BASELINE.md" },
        { "type": "file_exists", "path": "development/memory/DECISIONS.md" },
        { "type": "file_exists", "path": ".github/workflows/compliance.yml" }
      ]
    },
    {
      "id": "IAM-001",
      "title": "Authenticated role-based access is enforced at service boundaries",
      "sources": ["iso-27001-2022", "iso-27002-2022", "nist-csf-2", "nist-800-53-5-2-0", "gdpr-2016-679"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_contains", "path": "backend/routes/security.ts", "pattern": "requireRole\\(\\\"admin\\\"\\)" },
        { "type": "file_contains", "path": "backend/routes/ops-control.ts", "pattern": "requireRole\\(\\\"operator\\\"\\)" },
        { "type": "file_contains", "path": "backend/auth.ts", "pattern": "AUTH_REQUIRED" }
      ]
    },
    {
      "id": "AUD-001",
      "title": "Security events and privileged responses are auditable",
      "sources": ["iso-27001-2022", "iso-27002-2022", "nist-800-53-5-2-0", "gdpr-2016-679"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_contains", "path": "backend/cybertiger/daemon.ts", "pattern": "auth\\.failure" },
        { "type": "file_contains", "path": "backend/cybertiger/daemon.ts", "pattern": "ip\\.blocked" },
        { "type": "file_contains", "path": "backend/middleware/security.ts", "pattern": "x-request-id" }
      ]
    },
    {
      "id": "NET-001",
      "title": "Boundary protection, throttling, and secure response headers exist",
      "sources": ["iso-27002-2022", "nist-csf-2", "nist-800-53-5-2-0", "nist-ir-8401"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_contains", "path": "backend/cybertiger/daemon.ts", "pattern": "rateLimitWindowMs" },
        { "type": "file_contains", "path": "backend/middleware/security.ts", "pattern": "X-Content-Type-Options" },
        { "type": "file_contains", "path": "backend/middleware/security.ts", "pattern": "X-Frame-Options" }
      ]
    },
    {
      "id": "SPACE-001",
      "title": "CCSDS telemetry framing has executable decoder coverage",
      "sources": ["ccsds-blue-books", "nist-ir-8401"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_exists", "path": "gauss-orchestrator/src/telemetry/ccsds.rs" },
        { "type": "file_exists", "path": "gauss-orchestrator/tests/ccsds_decoder_tests.rs" },
        { "type": "package_script", "script": "test:orchestrator" }
      ]
    },
    {
      "id": "PRIV-001",
      "title": "Privacy-by-design technical controls protect stored operational data",
      "sources": ["iso-27701-2025", "gdpr-2016-679"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_contains", "path": "supabase/migrations/20260218234500_space_weather_rbac.sql", "pattern": "enable row level security" },
        { "type": "file_contains", "path": "supabase/migrations/20260302120000_user_onboarding.sql", "pattern": "enable row level security" },
        { "type": "file_contains", "path": "backend/middleware/security.ts", "pattern": "Permissions-Policy" }
      ]
    },
    {
      "id": "SDLC-001",
      "title": "Secure development and regression tests run in CI",
      "sources": ["nist-ssdf", "nist-800-53-5-2-0", "iso-27002-2022"],
      "enforcement": "blocking",
      "checks": [
        { "type": "workflow_contains", "path": ".github/workflows/ci-tests.yml", "pattern": "npm ci" },
        { "type": "workflow_contains", "path": ".github/workflows/ci-tests.yml", "pattern": "npm test" },
        { "type": "workflow_contains", "path": ".github/workflows/compliance.yml", "pattern": "npm audit" },
        { "type": "file_exists", "path": "package-lock.json" }
      ]
    },
    {
      "id": "OPS-001",
      "title": "Satellite operator actions use typed, approval-gated packets",
      "sources": ["nist-ir-8401", "ccsds-security-catalog", "iso-27001-2022"],
      "enforcement": "blocking",
      "checks": [
        { "type": "file_exists", "path": "agents/operator-task.schema.json" },
        { "type": "file_contains", "path": "agents/roles/satellite-operations.md", "pattern": "explicit human authorization" },
        { "type": "package_script", "script": "develop:task" }
      ]
    },
    {
      "id": "SPACE-SEC-001",
      "title": "CCSDS SDLS, authentication credentials, and key management are closed or formally tracked",
      "sources": ["ccsds-security-catalog", "nist-ir-8401", "nist-800-53-5-2-0"],
      "enforcement": "advisory",
      "checks": [
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "SDLS" },
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "key management" }
      ]
    },
    {
      "id": "GDPR-ROPA-001",
      "title": "Records of processing, lawful basis, and DPIA ownership are addressed",
      "sources": ["gdpr-2016-679", "iso-27701-2025"],
      "enforcement": "advisory",
      "checks": [
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "Article 30" },
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "DPIA" },
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "lawful basis" }
      ]
    },
    {
      "id": "GDPR-BREACH-001",
      "title": "Personal-data breach assessment and notification timing are defined",
      "sources": ["gdpr-2016-679", "nist-csf-2", "iso-27001-2022"],
      "enforcement": "advisory",
      "checks": [
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "72 hours" },
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "breach" }
      ]
    },
    {
      "id": "GDPR-TRANSFER-001",
      "title": "Processor contracts and international-transfer safeguards are identified",
      "sources": ["gdpr-2016-679", "iso-27701-2025"],
      "enforcement": "advisory",
      "checks": [
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "processor" },
        { "type": "file_contains", "path": "docs/COMPLIANCE_ALIGNMENT.md", "pattern": "international transfers" }
      ]
    }
  ]
}
