{
  "schema_version": 1,
  "scope": "Project Gauss software, ground-segment services, operator workflows, and development supply chain",
  "assumptions": [
    "CSDSS is interpreted as CCSDS (Consultative Committee for Space Data Systems).",
    "The repository can evidence technical controls; organizational, contractual, and legal conformity still require human governance and independent assessment.",
    "Official source pages are checked for version markers and content hashes; normative standards are not copied into the repository."
  ],
