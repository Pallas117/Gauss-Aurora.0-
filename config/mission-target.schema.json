{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauss.local/schemas/mission-target-v1.json",
  "title": "Gauss mission target onboarding profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "missionId",
    "targetSystem",
    "customerSegment",
    "orbit",
    "deploymentScope",
    "criticality",
    "spacecraftCount",
    "interfaces",
    "dataContract",
    "radiation",
    "compute",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "gauss-mission-target-v1" },
    "missionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$" },
    "targetSystem": { "type": "string", "minLength": 1, "maxLength": 160 },
    "customerSegment": {
      "enum": ["commercial_satcom", "weather_space_weather", "earth_observation", "pnt", "lunar_relay", "mission_integrator"]
    },
    "orbit": { "enum": ["LEO", "MEO", "GEO", "HEO", "lunar_orbit", "lunar_surface", "multi_orbit", "unknown"] },
    "deploymentScope": { "enum": ["ground_only", "simulator", "hosted_payload", "flight_candidate"] },
    "criticality": { "enum": ["routine", "important", "high", "safety_critical"] },
    "spacecraftCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ccsds", "xtce", "yamcs", "dtn", "cfsAdapter"],
      "properties": {
        "ccsds": { "enum": ["confirmed", "expected", "unknown", "not_applicable"] },
        "xtce": { "enum": ["confirmed", "expected", "unknown", "not_applicable"] },
        "yamcs": { "enum": ["confirmed", "expected", "unknown", "not_applicable"] },
        "dtn": { "enum": ["confirmed", "expected", "unknown", "not_applicable"] },
        "cfsAdapter": { "enum": ["required", "optional", "unknown", "not_applicable"] }
      }
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawTelemetryPreservation", "calibratedProducts", "replay", "telemetryRateBps", "maxContactGapSeconds"],
      "properties": {
        "rawTelemetryPreservation": { "type": "boolean" },
        "calibratedProducts": { "type": "boolean" },
        "replay": { "type": "boolean" },
        "telemetryRateBps": { "type": ["integer", "null"], "minimum": 0 },
        "maxContactGapSeconds": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "radiation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentModel", "hardwareEvidence", "eccEdac", "actionPolicy"],
      "properties": {
        "environmentModel": { "enum": ["mission_specific_required", "reviewed", "unknown"] },
        "hardwareEvidence": { "enum": ["qualified", "screened", "unknown"] },
        "eccEdac": { "enum": ["qualified", "present_unverified", "software_only", "unknown"] },
        "actionPolicy": { "enum": ["observe_only", "derate_and_abstain", "approval_required", "unknown"] }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryPolicy", "modelPolicy", "ramBudgetKb", "latencyBudgetMs"],
      "properties": {
        "memoryPolicy": { "enum": ["fixed_memory_required", "bounded_dynamic", "unknown"] },
        "modelPolicy": { "enum": ["deterministic_only", "frozen_residual_or_deterministic", "ground_only", "unknown"] },
        "ramBudgetKb": { "type": ["integer", "null"], "minimum": 0 },
        "latencyBudgetMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileStatus", "sourceRefs", "unknowns", "pilotFit"],
      "properties": {
        "profileStatus": { "enum": ["research_profile", "operator_confirmed", "integration_ready", "blocked"] },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "format": "uri" } },
        "unknowns": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 240 } },
        "pilotFit": { "enum": ["primary", "strategic", "evidence_partner", "future"] }
      }
    }
  }
}
