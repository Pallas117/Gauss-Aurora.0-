{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauss.local/schemas/turing-network-inventory-v1.json",
  "title": "Turing bounded network inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["observed_at", "mode", "authorized", "interfaces", "routes", "neighbors", "overlay_peers", "probes", "policy"],
  "properties": {
    "observed_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "mode": { "enum": ["passive", "approved"] },
    "authorized": { "type": "boolean" },
    "interfaces": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/interface" } },
    "routes": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/route" } },
    "neighbors": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/neighbor" } },
    "overlay_peers": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/peer" } },
    "probes": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/probe" } },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "shortString": { "type": "string", "minLength": 1, "maxLength": 160 },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "up", "addresses", "network_cidrs"],
      "properties": {
        "name": { "$ref": "#/$defs/shortString" }, "up": { "type": "boolean" },
        "addresses": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/shortString" } },
        "network_cidrs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/shortString" } }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["destination", "gateway", "interface"],
      "properties": { "destination": { "$ref": "#/$defs/shortString" }, "gateway": { "type": ["string", "null"], "maxLength": 160 }, "interface": { "type": ["string", "null"], "maxLength": 160 } }
    },
    "neighbor": {
      "type": "object", "additionalProperties": false, "required": ["address", "interface", "state"],
      "properties": { "address": { "$ref": "#/$defs/shortString" }, "interface": { "type": ["string", "null"], "maxLength": 160 }, "state": { "type": ["string", "null"], "maxLength": 40 } }
    },
    "peer": {
      "type": "object", "additionalProperties": false, "required": ["address", "hostname", "online", "platform", "last_seen"],
      "properties": { "address": { "$ref": "#/$defs/shortString" }, "hostname": { "type": ["string", "null"], "maxLength": 160 }, "online": { "type": ["boolean", "null"] }, "platform": { "type": ["string", "null"], "maxLength": 80 }, "last_seen": { "type": ["string", "null"], "maxLength": 40 } }
    },
    "probe": {
      "type": "object", "additionalProperties": false, "required": ["address", "port", "reachable", "latency_ms"],
      "properties": { "address": { "$ref": "#/$defs/shortString" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "reachable": { "type": "boolean" }, "latency_ms": { "type": ["number", "null"], "minimum": 0, "maximum": 60000 } }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["allowed_cidrs", "allowed_ports", "max_targets", "max_probes", "truncated", "errors"],
      "properties": {
        "allowed_cidrs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/shortString" } },
        "allowed_ports": { "type": "array", "maxItems": 64, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "max_targets": { "type": "integer", "minimum": 0, "maximum": 10000 }, "max_probes": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "truncated": { "type": "boolean" }, "errors": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/shortString" } }
      }
    }
  }
}
