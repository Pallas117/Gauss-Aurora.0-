{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauss.local/schemas/product-packages-v1.json",
  "title": "Gauss commercial product packages v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "partners", "packages"],
  "properties": {
    "schema": { "const": "gauss-product-packages-v1" },
    "partners": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "sourceUrl", "capabilities", "gaussWrap", "nonCompeteBoundary", "verificationStatus", "unknowns"],
        "properties": {
          "id": { "enum": ["xorbita", "jaops", "transcelestial", "pan-galactic"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "capabilities": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
          "gaussWrap": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
          "nonCompeteBoundary": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
          "verificationStatus": { "enum": ["public_capability_claim", "partner_confirmed"] },
          "unknowns": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tier", "positioning", "delivery", "installArtifacts", "requiredInputs", "acceptanceTests", "externalGates", "partnerBoundary", "safety"],
        "properties": {
          "id": { "enum": ["fleet-integration", "flight-candidate-adapter", "bridge-node"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "tier": { "enum": ["commercial", "flight-candidate", "infrastructure"] },
          "positioning": { "type": "string", "minLength": 1, "maxLength": 500 },
          "delivery": { "enum": ["self_hosted_ground", "cfs_source_and_target_build", "self_hosted_bridge_node"] },
          "installArtifacts": { "type": "array", "minItems": 3, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "requiredInputs": { "type": "array", "minItems": 3, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "acceptanceTests": { "type": "array", "minItems": 4, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "externalGates": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "partnerBoundary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partnerOwned", "gaussOwned", "gaussDoesNotOwn", "integrationSurface"],
            "properties": {
              "partnerOwned": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
              "gaussOwned": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
              "gaussDoesNotOwn": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
              "integrationSurface": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "safety": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commandAuthority", "onlineTraining", "fallback", "approvalRequired"],
            "properties": {
              "commandAuthority": { "const": false },
              "onlineTraining": { "const": false },
              "fallback": { "const": "deterministic_baseline" },
              "approvalRequired": { "const": true }
            }
          }
        }
      }
    }
  }
}
