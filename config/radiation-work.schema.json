{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauss.local/schemas/gauss-radiation-work-v1.json",
  "title": "Gauss radiation work request",
  "type": "object",
  "additionalProperties": false,
  "required": ["samples"],
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["energy_mev", "flux"],
        "properties": {
          "timestamp": {"type": "string", "maxLength": 80},
          "energy_mev": {"type": "number", "minimum": 0, "maximum": 1000000},
          "flux": {"type": "number", "minimum": 0, "maximum": 1e30},
          "species": {"enum": ["electron", "proton", "mixed"]}
        }
      }
    },
    "source": {"type": "string", "maxLength": 80},
    "window_start": {"type": "string", "maxLength": 80},
    "window_end": {"type": "string", "maxLength": 80},
    "priority": {"enum": ["low", "normal", "high"]},
    "required_memory_mb": {"type": "integer", "minimum": 64, "maximum": 4096},
    "min_battery_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}
  }
}
