{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauss.local/schemas/gauss-seven-zone-v1.json",
  "title": "Gauss seven-zone analysis and qualification contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assessmentId", "generatedAt", "missionId", "deploymentScope", "mode", "qualificationEvidence", "zones", "aggregateState", "decision", "blockers", "limitations"],
  "properties": {
    "schema": { "const": "gauss-seven-zone-v1" },
    "assessmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "deploymentScope": { "enum": ["ground_only", "simulator", "hosted_payload", "flight_candidate"] },
    "mode": { "enum": ["environmental_screening", "mission_qualification"] },
    "qualificationEvidence": { "type": "boolean" },
    "zones": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/zone" } },
    "aggregateState": { "enum": ["nominal", "degraded", "unknown", "blocked"] },
    "decision": { "enum": ["qualified", "screened", "unknown", "blocked"] },
    "blockers": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 160 } },
    "limitations": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 240 } }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "applicability", "state", "evidence", "reasons", "blockers"],
      "properties": {
        "id": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "applicability": { "enum": ["required", "advisory", "not_applicable"] },
        "state": { "enum": ["nominal", "degraded", "unknown", "blocked"] },
        "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } },
        "reasons": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 240 } },
        "blockers": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 160 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt", "provenanceRefs"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "provenanceRefs": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 256 } },
        "rawPacketId": { "type": "string", "maxLength": 128 },
        "apid": { "type": "integer", "minimum": 0, "maximum": 2047 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "quality": { "enum": ["unknown", "low", "high"] },
        "uncertainty": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "number" } }
      }
    }
  }
}
