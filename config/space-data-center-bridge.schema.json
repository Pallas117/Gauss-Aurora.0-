{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauss.local/schemas/space-data-center-bridge-v1.json",
  "title": "Gauss federated space data-center bridge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bridgeId", "mode", "trustZones", "nodes", "links", "dataProducts", "computePolicy", "safety"],
  "properties": {
    "schema": { "const": "gauss-space-data-center-bridge-v1" },
    "bridgeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$" },
    "mode": { "enum": ["ground_simulation", "hosted_payload", "flight_candidate"] },
    "trustZones": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "segment", "commandAuthority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,64}$" },
          "segment": { "enum": ["LEO", "MEO", "GEO", "lunar", "ground"] },
          "commandAuthority": { "const": false }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "zone", "role", "memoryBudgetMb", "maxPayloadBytes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,64}$" },
          "zone": { "type": "string", "minLength": 3, "maxLength": 64 },
          "role": { "enum": ["producer", "relay", "compute", "archive", "operator_gateway"] },
          "memoryBudgetMb": { "type": "integer", "minimum": 16, "maximum": 1048576 },
          "maxPayloadBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "destination", "transport", "maxPayloadBytes", "storeAndForward"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,64}$" },
          "source": { "type": "string", "minLength": 3, "maxLength": 64 },
          "destination": { "type": "string", "minLength": 3, "maxLength": 64 },
          "transport": { "enum": ["ccsds", "dtn_bp", "https_ground_only", "tailscale_ground_only"] },
          "maxPayloadBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
          "storeAndForward": { "type": "boolean" }
        }
      }
    },
    "dataProducts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "integrity", "encryption", "replication", "staleAction"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,64}$" },
          "class": { "enum": ["raw_packet", "calibrated_product", "derived_feature", "radiation_assessment", "tensor_window", "model_artifact", "recommendation"] },
          "integrity": { "const": "sha256" },
          "encryption": { "const": "required" },
          "replication": { "type": "integer", "minimum": 1, "maximum": 8 },
          "staleAction": { "enum": ["retain_context", "abstain", "discard"] }
        }
      }
    },
    "computePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentLeases", "maxLeaseBytes", "requireHealthyNode", "requireNominalRadiation", "allowOnlineTraining", "fallback"],
      "properties": {
        "maxConcurrentLeases": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maxLeaseBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
        "requireHealthyNode": { "const": true },
        "requireNominalRadiation": { "const": true },
        "allowOnlineTraining": { "const": false },
        "fallback": { "const": "deterministic_baseline" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandAuthority", "unknownState", "staleState", "approvalRequired"],
      "properties": {
        "commandAuthority": { "const": false },
        "unknownState": { "const": "abstain" },
        "staleState": { "const": "abstain" },
        "approvalRequired": { "const": true }
      }
    }
  }
}
