# GAUSS Orchestrator Configuration
# Copy this file to .env and adjust values for your environment

# ===== Telemetry Input =====
# Directory to watch for incoming telemetry CSV/packet files (Lights-Out Watchdog). Default: ./telemetry_drop
ORCHESTRATOR_TELEMETRY_DIR=./telemetry_drop

# ===== Triad Pipeline (Surya -> DeepSeek via backend direct API) =====
# Backend base URL for POST /api/ops/pipeline/triad (e.g. http://127.0.0.1:3001)
# ORCHESTRATOR_PIPELINE_API_URL=http://127.0.0.1:3001
# Set to true to trigger triad on each CSV drop
# ORCHESTRATOR_TRIAD_ON_CSV=false

# File system watch debounce interval (milliseconds)
# Prevents processing duplicate file events for rapidly created files
ORCHESTRATOR_WATCH_DEBOUNCE_MS=2000

# ===== Local Inference Engine =====
# URL of the local chat/completions endpoint (DeepSeek, MLX, or gauss-brain-stub).
# Default if unset: http://127.0.0.1:8089/v1/chat/completions (stub or MLX on 8089).
# ORCHESTRATOR_LOCAL_ENGINE_URL=http://localhost:8080/v1/chat/completions

# Model name sent in requests (default: local-model). Set to match your MLX server if needed.
# ORCHESTRATOR_CHAT_MODEL=local-model

# Optional API key for cloud DeepSeek; leave unset for local MLX/stub.
# ORCHESTRATOR_LOCAL_ENGINE_API_KEY=

# ===== No egress (local decision models only) =====
# Default: true. Only 127.0.0.1, ::1, or Tailscale 100.x.x.x may be used for inference; no cloud LLM egress.
# Set to false/0 to allow cloud models (GPT-4, Gemini, Claude) when API keys are set.
# ORCHESTRATOR_STRICT_LOCAL_INFERENCE=true

# Default: true. Daily mission summary is generated by the local engine only (no OpenAI egress).
# Set to false and set OPENAI_API_KEY to use OpenAI for daily summary.
# ORCHESTRATOR_DAILY_SUMMARY_USE_LOCAL=true

# ===== Cloud Routing =====
# Default: false. Set to true only if you want LOW/UNKNOWN telemetry sent to OpenAI.
# When false, all telemetry is analyzed by the local engine only (offline-friendly).
ORCHESTRATOR_CLOUD_ENABLED=false

# Cloud provider API key (only used when ORCHESTRATOR_CLOUD_ENABLED=true)
# Currently a placeholder for future OpenAI/Azure/other provider integration
# OPENAI_API_KEY=your-key-here
# ORCHESTRATOR_OPENAI_API_KEY=your-key-here

# SECURITY: never commit real API keys into source control.
# Set your API key in the environment before starting the orchestrator:
#
# On macOS / zsh:
# export ORCHESTRATOR_OPENAI_API_KEY="sk-..."
# OR run via env on a single command:
# ORCHESTRATOR_OPENAI_API_KEY="sk-..." cargo run --release

# ===== Network & Timeout =====
# HTTP request timeout (seconds) for all remote service calls
ORCHESTRATOR_HTTP_TIMEOUT_SECONDS=8

# ===== Pass Orchestration API =====
# Enable API-first pass orchestration scaffold
ORCHESTRATOR_PASS_API_ENABLED=false

# Bind address for pass API server
ORCHESTRATOR_PASS_API_BIND=127.0.0.1:8091

# ===== Telegram (Optional) =====
# Leave unset/blank to disable Telegram integration.
# ORCHESTRATOR_TELEGRAM_BOT_TOKEN=
# ORCHESTRATOR_TELEGRAM_CHAT_ID=
# Long-poll timeout for get_updates (seconds). Default 90; use 60-120 if you see "operation timed out".
# ORCHESTRATOR_TELEGRAM_POLL_TIMEOUT_SECS=90

# ===== Offline / local model only =====
# To run without any cloud model (only your local MLX DeepSeek or gauss-brain-stub):
# 1. Leave ORCHESTRATOR_CLOUD_ENABLED=false (default).
# 2. Point ORCHESTRATOR_LOCAL_ENGINE_URL at your local server, or leave unset to use
#    http://127.0.0.1:8089/v1/chat/completions (start stub with: npm run dev:brain:stub).
# 3. No OPENAI_API_KEY or other cloud keys needed.
# All telemetry (HIGH and LOW/UNKNOWN) is then analyzed by the local engine only.
# Verify with: npm run test:local-chat (from repo root).

# ===== Telegram Chat Bridge (Optional) =====
# Plain text messages and /ask are routed to this chat engine.
# Defaults to ORCHESTRATOR_LOCAL_ENGINE_URL when unset.
# ORCHESTRATOR_CHAT_ENGINE_URL=http://127.0.0.1:8089/v1/chat/completions
# ORCHESTRATOR_CHAT_MODEL=local-model

# ===== Audit Automation + Approval Gate (Optional) =====
# Runs in background: audit, progress, and reports run first (no human). You can continue
# with other tasks; human-in-the-loop only when WARN/FAIL for fix approval.
# ORCHESTRATOR_AUDIT_AUTOMATION_ENABLED=false
# ORCHESTRATOR_AUDIT_INTERVAL_SECS=1800
# ORCHESTRATOR_AUDIT_REQUIRE_APPROVAL=true
# ORCHESTRATOR_AUDIT_APPROVAL_TIMEOUT_SECS=900
# If set (RFC 3339 UTC, e.g. 2026-02-28T10:00:00Z), fix phase runs without permission until this time.
# ORCHESTRATOR_AUTO_APPROVE_UNTIL_UTC=
# ORCHESTRATOR_AUDIT_COMMAND=npm run audit:adherence:record
# ORCHESTRATOR_AUDIT_FIX_COMMAND=npm run progress:short:refresh
# ORCHESTRATOR_AUDIT_REPORT_PATH=reports/progress/requirements-audit.latest.json
# ORCHESTRATOR_AUDIT_RUN_FIX_WORKFLOW=true
# Run context:backprop after each audit (writes reports/context/latest-backprop.*). No human input.
# ORCHESTRATOR_BACKPROP_AFTER_AUDIT=false
# ORCHESTRATOR_BACKPROP_COMMAND=npm run context:backprop
# Work queue path (workspace-relative). Used by patch batch loop and full-codebase scan.
# ORCHESTRATOR_WORK_QUEUE_PATH=reports/orchestrator/work-queue.json
# Patch batch loop: run after fix command (when enabled). Default true.
# ORCHESTRATOR_PATCH_BATCH_LOOP_ENABLED=true
# Batch size (items per batch) and max batches per cycle.
# ORCHESTRATOR_PATCH_BATCH_SIZE=2
# ORCHESTRATOR_MAX_PATCH_BATCHES_PER_CYCLE=10
# Scan roots for code indexer (comma-separated, workspace-relative). Default: ./src,./gauss-orchestrator/src
# ORCHESTRATOR_SCAN_ROOTS=./src,./gauss-orchestrator/src

# Pipeline phases (run in order before audit). Each message includes progress checker + cycle timer.
# Orchestrator phase runs natively (cargo test); others run via npm. Battery gate skips phases when low.
# ORCHESTRATOR_AUTOMATION_PHASE_ORCHESTRATOR_TESTS=true   # cargo test --all-targets in gauss-orchestrator
# ORCHESTRATOR_AUTOMATION_PHASE_BACKEND_TESTS=true        # npm test
# ORCHESTRATOR_AUTOMATION_PHASE_E2E_UI=false             # npm run test:ui (Playwright)
# ORCHESTRATOR_AUTOMATION_PHASE_FRONTEND=false           # npm run lint && npm run test:unit:ui
# ORCHESTRATOR_AUTOMATION_PHASE_FULLSCAN=false           # npm run test:orchestrator:analyze (codebase scan)

# Run audit script by path (node + tsx) instead of npm run. Requires workspace root as cwd.
# ORCHESTRATOR_AUDIT_USE_SCRIPT_PATH=false

# ===== Project Recap (Telegram /recap, optional at cycle start) =====
# When true, at start of each audit cycle gather context and ask local model for recap; write to reports/orchestrator/recap-latest.txt
# ORCHESTRATOR_RECAP_AT_CYCLE_START=false
# Max bytes to include from docs (WORKSPACE_MAP, PROJECT_GAUSS_PLAIN_ENGLISH) in recap context. Default 3072.
# ORCHESTRATOR_RECAP_DOCS_MAX_BYTES=3072

# ===== Model-assisted fix decision (env-gated) =====
# When true and audit has WARN/FAIL, ask local model for RUN_FIX/DEFER/ASK_HUMAN; RUN_FIX skips approval for this cycle.
# ORCHESTRATOR_MODEL_ASSISTED_FIX_DECISION=false

# ===== Advanced Options =====
# (Uncomment to customize)

# Enable detailed logging of sensitivity detection patterns
# ORCHESTRATOR_ENABLE_PATTERN_DEBUG=false

# Enable verbose logging for anonymization transformations
# ORCHESTRATOR_ENABLE_ANONYMIZATION_DEBUG=false

# Maximum number of files to process before restart (0 = unlimited)
# ORCHESTRATOR_MAX_FILES_PER_RUN=0

# Email/webhook for alerts on high-sensitivity detection
# ORCHESTRATOR_ALERT_WEBHOOK_URL=

# ===== Project Integration =====
# These match the broader Gauss Aurora project settings
GAUSS_ORCHESTRATOR_ENABLED=true
