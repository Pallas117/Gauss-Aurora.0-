{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node --env-file-if-exists=.env --import tsx backend/server.ts",
    "start:public": "node --env-file-if-exists=.env --env-file-if-exists=.env.public.local --import tsx backend/server.ts",
    "dev:brain:stub": "node --env-file-if-exists=.env --import tsx backend/scripts/gauss-brain-stub.ts",
