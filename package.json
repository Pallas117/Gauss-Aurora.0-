    "dev:infer": "python3 ml/infer/infer_server.py",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run dev:proxy\"",
    "dev:battery": "VITE_POWER_PROFILE=low-power VITE_POLL_INTERVAL_MULTIPLIER=2 VITE_BATTERY_DRAIN_MODE=recharge-first POWER_SAVE_MODE=true INGEST_POWER_PROFILE=low-power INGEST_CHARGING_FLOW_MODE=recharge-first INGEST_ADAPTIVE_CHARGING_FLOW=true ORCHESTRATOR_DISCHARGING_MIN_SAFE_BATTERY_PERCENT=50 VITE_HELIO_WS_ENABLED=false concurrently -k -n FE,API -c cyan,green \"npm run dev\" \"npm run dev:proxy\"",
    "dev:battery:full": "VITE_POWER_PROFILE=low-power VITE_POLL_INTERVAL_MULTIPLIER=2 VITE_BATTERY_DRAIN_MODE=recharge-first POWER_SAVE_MODE=true INGEST_POWER_PROFILE=low-power INGEST_CHARGING_FLOW_MODE=recharge-first INGEST_ADAPTIVE_CHARGING_FLOW=true ORCHESTRATOR_DISCHARGING_MIN_SAFE_BATTERY_PERCENT=50 VITE_HELIO_WS_ENABLED=false concurrently -k -n FE,API,BRAIN -c cyan,green,magenta \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:stub\"",
    "dev:orchestrator": "bash scripts/process/run-orchestrator.sh",
    "dev:orchestrator:build": "bash scripts/process/run-orchestrator.sh --build",
    "orchestrator": "cd gauss-orchestrator && cargo run --release",
    "dev:prune": "bash scripts/process/kill-stale.sh",
    "dev:prune:dry": "bash scripts/process/kill-stale.sh --dry-run",
    "port:brain": "lsof -nP -iTCP:8089 -sTCP:LISTEN",
    "dev:stack": "concurrently -k -n FE,API,BRAIN -c cyan,green,magenta \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:stub\"",
    "dev:stack:mlx": "GAUSS_BRAIN_URL=http://127.0.0.1:8088/v1 ORCHESTRATOR_LOCAL_ENGINE_URL=http://127.0.0.1:8088/v1/chat/completions concurrently -k -n FE,API,BRAIN -c cyan,green,magenta \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:mlx\"",
    "dev:offline": "GAUSS_BRAIN_URL=http://127.0.0.1:8089/v1 ORCHESTRATOR_LOCAL_ENGINE_URL=http://127.0.0.1:8089/v1/chat/completions concurrently -k -n FE,API,BRAIN -c cyan,green,magenta \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:stub\"",
    "dev:offline:full": "GAUSS_BRAIN_URL=http://127.0.0.1:8089/v1 ORCHESTRATOR_LOCAL_ENGINE_URL=http://127.0.0.1:8089/v1/chat/completions concurrently -k -n FE,API,BRAIN,ORCH -c cyan,green,magenta,yellow \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:stub\" \"npm run dev:orchestrator\"",
    "dev:stack:local": "concurrently -k -n FE,API,BRAIN,CHAT -c cyan,green,magenta,yellow \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:stub\" \"sh -c 'sleep 4 && npm run test:local-chat'\"",
    "dev:stack:full": "concurrently -k -n FE,API,BRAIN,ORCH -c cyan,green,magenta,yellow \"npm run dev\" \"npm run dev:proxy\" \"npm run dev:brain:stub\" \"npm run dev:orchestrator\"",
